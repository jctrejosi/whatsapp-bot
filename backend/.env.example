# ─── DeepSeek ───────────────────────────────
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
MAX_TOKENS=2000
MAX_HISTORY_MESSAGES=6

# ─── Knowledge Service ──────────────────────
KNOWLEDGE_SERVICE_URL=http://localhost:8000

# ─── PostgreSQL (misma DB que knowledge-service) ──
DATABASE_URL=postgresql://knowledge:knowledge@localhost:5432/knowledge_db

# ─── WhatsApp Cloud API ─────────────────────
WHATSAPP_APP_ID=TU_APP_ID
WHATSAPP_APP_SECRET=TU_APP_SECRET
WHATSAPP_WABA_ID=TU_WABA_ID
WHATSAPP_PHONE=+1234567890
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_ACCESS_TOKEN=TU_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=TU_VERIFY_TOKEN_ALEATORIO

# ─── Escalation (Resend) ───────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_SENDER_EMAIL=onboarding@resend.dev
ESCALATION_EMAIL=info@angelasvacations.com
MIN_CONFIDENCE=0.65
MAX_NEGATIVE_RESPONSES=5

# ─── Cloudinary (upload de documentos) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Server ────────────────────────────────
PORT=3000
